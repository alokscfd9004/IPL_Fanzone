# ── IPL FanZone env template ── copy to .env locally; on hosts, set via their secrets tooling
# Required in production
SECRET_KEY=          # python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
ALLOWED_HOSTS=your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
SITE_URL=https://your-domain.com

# Jarvis AI (Groq console → https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
USE_LANGCHAIN_RAG=false

# Rate limits: count/period (s,m,h,d)
JARVIS_RATE_PER_MINUTE=10/m
JARVIS_RATE_PER_DAY=50/d
JARVIS_GLOBAL_PER_DAY=1000/d
LIVE_API_RATE_PER_MINUTE=30/m
PRIVACY_API_RATE_PER_MINUTE=10/m

# Optional production overrides
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=  DB_USER=  DB_PASSWORD=  DB_HOST=  DB_PORT=
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://...
